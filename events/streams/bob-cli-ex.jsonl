{"schema_version":1,"event_id":"bob-cli-ex:000001:issue_created:bob-cli-ex:e83485aa986c33de763340889628f9e46c8e20d5afac6e8dc9e57d061d0b6bb1","timestamp":"2026-10-31T16:01:11Z","actor":"bbugyi200.apollo.bp.f0","operation":"issue_created","issue_id":"bob-cli-ex","payload":{"kind":"issue_created","issue":{"id":"bob-cli-ex","title":"Project-note seals: @route^id@, @route:id@, and the project successor prompt","status":"open","issue_type":"plan","tier":"epic","parent_id":null,"owner":"bryanbugyi34@gmail.com","assignee":"","created_at":"2026-10-31T16:01:11Z","created_by":"bbugyi200.apollo.bp.f0","updated_at":"2026-10-31T16:01:11Z","closed_at":null,"close_reason":null,"description":"A project note is sealed with `@`. `@route^id@` creates it, and `@route:id@` creates it and then lets Bryan pick which of its tasks get Pomodoro Task Links in the existing successor choice card. `+` typed after `@route^id` now switches to `@route+id`, like every other separator. Bob Mac Capture draws both sealed markers as one \"manila chip\" so a project note is easy to spot in a draft.","design":"plan:202610/project_note_seals.md","model":"","is_ready_to_work":false,"changespec_name":"","changespec_bug_id":"","creation_reason":"Approved epic plan plan:202610/project_note_seals.md requests this work","dependencies":[]}}}
